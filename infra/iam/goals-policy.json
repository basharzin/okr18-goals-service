{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnTableOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query", "dynamodb:Scan"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/Goals",
        "arn:aws:dynamodb:us-east-1:000000000000:table/Goals/index/userId-year-index"
      ]
    },
    {
      "Sid": "PublishGoalEvents",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:000000000000:okr-events"
    },
    {
      "Sid": "AskKeyResultsForProgress",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:kr-internal"
    },
    {
      "Sid": "OwnMetricNamespaceOnly",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": { "StringEquals": { "cloudwatch:namespace": "OKR18/Goals" } }
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/goals-*"
    }
  ]
}
