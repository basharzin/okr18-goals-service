# Copy to .env for running on your PC (npm run dev). Never commit .env.
# None of these are secrets: they are names, ids and addresses.
PORT=3001
NODE_ENV=development
AWS_PROFILE=floci
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

GOALS_TABLE=Goals
# Leave empty on a PC to use a stub until Key Results is deployed
KR_INTERNAL_FUNCTION=
# From okr18-frontend/infra/okr18-vars.sh after the shared setup
EVENTS_TOPIC_ARN=
COGNITO_ISSUER=
# On a PC use COGNITO_JWKS_URI_LOCAL from okr18-vars.sh (localhost, not floci)
COGNITO_JWKS_URI=
COGNITO_CLIENT_ID=
# Floci serves its keys over http; never set this on real AWS
ALLOW_HTTP_JWKS=true
CORS_ORIGINS=http://localhost:8080
